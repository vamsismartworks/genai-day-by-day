# Copy this file to .env and fill in the key(s) for the provider(s) you want to use.
# You only need ONE key to get started.

# Google Gemini — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=your-api-key-here

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Default provider when you don't pass --provider: gemini, claude, openai or ollama
LLM_PROVIDER=gemini
